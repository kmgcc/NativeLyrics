<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml"
    xmlns:ttm="http://www.w3.org/ns/ttml#metadata"
    xmlns:tts="http://www.w3.org/ns/ttml#styling"
    xml:lang="en">
  <head>
    <metadata>
      <ttm:title>Slow Fire</ttm:title>
      <ttm:agent xml:id="lead" type="person"/>
    </metadata>
  </head>
  <body dur="48s">
    <div begin="0s" end="33s">
      <p begin="0s" end="10s" ttm:agent="lead">
        <span begin="0s" end="3.4s">Embers </span><span begin="3.4s" end="7s">breathe </span><span begin="7s" end="10s">slow</span>
        <span ttm:role="x-translation" xml:lang="zh-Hans">余烬缓缓呼吸</span>
      </p>
      <p begin="11s" end="21s" ttm:agent="lead">
        <span begin="11s" end="13.4s">Stay </span><span begin="13.4s" end="15.6s">here </span><span begin="15.6s" end="16.8s">by </span><span begin="16.8s" end="18.4s">the </span><span begin="18.4s" end="21s">fire</span>
        <span ttm:role="x-bg"><span begin="12s" end="15.2s">Echo </span><span begin="15.2s" end="18s">around </span><span begin="18s" end="20.6s">us</span></span>
        <span ttm:role="x-translation" xml:lang="zh-Hans">留在火光旁边</span>
      </p>
      <p begin="22s" end="33s" ttm:agent="lead">
        <span begin="22s" end="24.6s">Every </span><span begin="24.6s" end="27.6s">moment </span><span begin="27.6s" end="30.2s">shines </span><span begin="30.2s" end="33s">tonight</span>
        <span ttm:role="x-translation" xml:lang="zh-Hans">每一个瞬间都在今夜发光</span>
      </p>
    </div>
    <div begin="40s" end="47s">
      <p begin="40s" end="47s" ttm:agent="lead">
        <span begin="40s" end="42.4s">Carry </span><span begin="42.4s" end="44.6s">the </span><span begin="44.6s" end="47s">glow</span>
        <span ttm:role="x-bg"><span begin="40.6s" end="42.8s">Glow </span><span begin="42.8s" end="44.8s">glow </span><span begin="44.8s" end="46.8s">glow</span></span>
        <span ttm:role="x-translation" xml:lang="zh-Hans">带着光芒继续前行</span>
      </p>
    </div>
  </body>
</tt>
