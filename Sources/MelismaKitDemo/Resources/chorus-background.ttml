<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml"
    xmlns:ttm="http://www.w3.org/ns/ttml#metadata"
    xml:lang="en">
  <head>
    <metadata>
      <ttm:title>We Rise</ttm:title>
      <ttm:agent xml:id="lead" type="person"/>
    </metadata>
  </head>
  <body dur="44s">
    <div begin="0s" end="29s">
      <p begin="0s" end="9s" ttm:agent="lead">
        <span begin="0s" end="2.4s">We </span><span begin="2.4s" end="4.8s">rise </span><span begin="4.8s" end="9s">together</span>
        <span ttm:role="x-bg"><span begin="0.4s" end="2.4s">Rise </span><span begin="2.4s" end="4.4s">rise </span><span begin="4.4s" end="6.4s">rise </span><span begin="6.4s" end="8.8s">together</span></span>
        <span ttm:role="x-translation" xml:lang="zh-Hans">我们一起升起</span>
      </p>
      <p begin="10s" end="19s" ttm:agent="lead">
        <span begin="10s" end="12.2s">Hear </span><span begin="12.2s" end="14.6s">the </span><span begin="14.6s" end="19s">voices</span>
        <span ttm:role="x-bg"><span begin="10.1s" end="12.4s">Voices </span><span begin="12.4s" end="14.6s">in </span><span begin="14.6s" end="16.8s">the </span><span begin="16.8s" end="18.8s">distance</span></span>
        <span ttm:role="x-translation" xml:lang="zh-Hans">听见远方的声音</span>
      </p>
      <p begin="20s" end="29s" ttm:agent="lead">
        <span begin="20s" end="22.1s">Nothing </span><span begin="22.1s" end="24.3s">can </span><span begin="24.3s" end="26.5s">hold </span><span begin="26.5s" end="29s">us</span>
        <span ttm:role="x-bg"><span begin="20.6s" end="22.6s">No </span><span begin="22.6s" end="24.6s">one </span><span begin="24.6s" end="26.6s">can </span><span begin="26.6s" end="28.5s">stop</span></span>
        <span ttm:role="x-translation" xml:lang="zh-Hans">没有什么能拦住我们</span>
      </p>
    </div>
    <div begin="37s" end="43s">
      <p begin="37s" end="43s" ttm:agent="lead">
        <span begin="37s" end="39s">Sing </span><span begin="39s" end="41s">it </span><span begin="41s" end="43s">louder</span>
        <span ttm:role="x-bg"><span begin="37s" end="39s">Louder </span><span begin="39s" end="41s">and </span><span begin="41s" end="43s">louder</span></span>
        <span ttm:role="x-translation" xml:lang="zh-Hans">放声歌唱</span>
      </p>
    </div>
  </body>
</tt>
