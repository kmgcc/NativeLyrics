<?xml version="1.0" encoding="UTF-8"?>
<tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xml:lang="ja">
  <head><metadata><ttm:title>Synthetic Ruby</ttm:title></metadata></head>
  <body dur="31.6s">
<p begin="0s" end="3.6s"><span begin="0s" end="1.2s" tts:ruby="container"><span tts:ruby="base">夜明け</span><span tts:ruby="text" begin="0s" end="1.2s">よあけ</span></span><span begin="1.2s" end="2.4s">の</span><span begin="2.4s" end="3.6s" tts:ruby="container"><span tts:ruby="base">光</span><span tts:ruby="text" begin="2.4s" end="3.6s">ひかり</span></span></p>
<p begin="4s" end="7.6s"><span begin="4s" end="4.9s" tts:ruby="container"><span tts:ruby="base">遠い</span><span tts:ruby="text" begin="4s" end="4.9s">とおい</span></span><span begin="4.9s" end="5.8s" tts:ruby="container"><span tts:ruby="base">風</span><span tts:ruby="text" begin="4.9s" end="5.8s">かぜ</span></span><span begin="5.8s" end="6.7s">の</span><span begin="6.7s" end="7.6s" tts:ruby="container"><span tts:ruby="base">音</span><span tts:ruby="text" begin="6.7s" end="7.6s">おと</span></span></p>
<p begin="8s" end="11.6s"><span begin="8s" end="9.8s" tts:ruby="container"><span tts:ruby="base">静かな</span><span tts:ruby="text" begin="8s" end="9.8s">しずかな</span></span><span begin="9.8s" end="11.6s" tts:ruby="container"><span tts:ruby="base">海辺</span><span tts:ruby="text" begin="9.8s" end="11.6s">うみべ</span></span></p>
<p begin="12s" end="15.6s"><span begin="12s" end="13.2s" tts:ruby="container"><span tts:ruby="base">小さな</span><span tts:ruby="text" begin="12s" end="13.2s">ちいさな</span></span><span begin="13.2s" end="14.4s" tts:ruby="container"><span tts:ruby="base">花</span><span tts:ruby="text" begin="13.2s" end="14.4s">はな</span></span><span begin="14.4s" end="15.6s">のように</span></p>
<p begin="16s" end="19.6s"><span begin="16s" end="16.9s" tts:ruby="container"><span tts:ruby="base">季節</span><span tts:ruby="text" begin="16s" end="16.9s">きせつ</span></span><span begin="16.9s" end="17.8s">が</span><span begin="17.8s" end="18.7s" tts:ruby="container"><span tts:ruby="base">巡る</span><span tts:ruby="text" begin="17.8s" end="18.7s">めぐる</span></span><span begin="18.7s" end="19.6s">よ</span></p>
<p begin="20s" end="23.6s"><span begin="20s" end="20.9s" tts:ruby="container"><span tts:ruby="base">空</span><span tts:ruby="text" begin="20s" end="20.9s">そら</span></span><span begin="20.9s" end="21.8s">を</span><span begin="21.8s" end="22.7s" tts:ruby="container"><span tts:ruby="base">渡る</span><span tts:ruby="text" begin="21.8s" end="22.7s">わたる</span></span><span begin="22.7s" end="23.6s" tts:ruby="container"><span tts:ruby="base">鳥</span><span tts:ruby="text" begin="22.7s" end="23.6s">とり</span></span></p>
<p begin="24s" end="27.6s"><span begin="24s" end="24.9s" tts:ruby="container"><span tts:ruby="base">君</span><span tts:ruby="text" begin="24s" end="24.9s">きみ</span></span><span begin="24.9s" end="25.8s">の</span><span begin="25.8s" end="26.7s" tts:ruby="container"><span tts:ruby="base">笑顔</span><span tts:ruby="text" begin="25.8s" end="26.7s">えがお</span></span><span begin="26.7s" end="27.6s">が</span></p>
<p begin="28s" end="31.6s"><span begin="28s" end="28.9s" tts:ruby="container"><span tts:ruby="base">星</span><span tts:ruby="text" begin="28s" end="28.9s">ほし</span></span><span begin="28.9s" end="29.8s">が</span><span begin="29.8s" end="30.7s" tts:ruby="container"><span tts:ruby="base">降る</span><span tts:ruby="text" begin="29.8s" end="30.7s">ふる</span></span><span begin="30.7s" end="31.6s" tts:ruby="container"><span tts:ruby="base">夜</span><span tts:ruby="text" begin="30.7s" end="31.6s">よる</span></span></p>
  </body>
</tt>